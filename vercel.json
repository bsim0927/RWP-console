{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,tests/**,e2e/**,rust/**,supabase/**,scripts/**,docs/**,.venv/**,web/legacy.html}"
    }
  }
}
